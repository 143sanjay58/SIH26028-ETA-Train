# Database
DATABASE_URL=postgresql+asyncpg://railway:railway@localhost:5432/railway_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Weather API (OpenWeatherMap or Open-Meteo)
WEATHER_API_KEY=your-open-exchange-weather-api-key
WEATHER_PROVIDER=open-meteo

# AI Providers
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra

GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

PRIMARY_AI_PROVIDER=nvidia
FALLBACK_AI_PROVIDER=gemini

AI_REQUEST_TIMEOUT=30.0
AI_MAX_RETRIES=3

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Simulation
SIMULATION_SPEED=1.0
SIMULATION_SCENARIO=normal

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000